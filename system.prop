#
# System properties for Samsung Galaxy Note 10.1 (2014) LTE (lt03lte / SM-P605S)
#

# Set WiFi interface
wifi.interface=wlan0

# Set vendor extensions library
ro.vendor.extension_library=libqti-perfd-client.so

# Camera
camera2.portability.force_api=1
media.stagefright.legacyencoder=true
media.stagefright.less-secure=true

# RIL (Samsung Qualcomm RIL)
rild.libpath=/system/vendor/lib/libsec-ril.gsm.so
rild.libargs=-d /dev/smd0
ro.ril.telephony.mqanelements=6
ro.telephony.call_ring.multiple=0
persist.rild.nitz_plmn=
persist.rild.nitz_long_ons_0=
persist.rild.nitz_long_ons_1=
persist.rild.nitz_long_ons_2=
persist.rild.nitz_long_ons_3=
persist.rild.nitz_short_ons_0=
persist.rild.nitz_short_ons_1=
persist.rild.nitz_short_ons_2=
persist.rild.nitz_short_ons_3=
ril.subscription.types=NV,RUIM

# GSM/LTE only: don't forward CDMA subscription source (RTRE) changes,
# they crash the modem on the next LPM -> online transition
ro.vendor.ril.ignore_cdma_subscription_source=true

# Answer BASEBAND_VERSION from ril.sw_ver so libsec-ril doesn't re-run
# InitMiscInformation() (factory IPCs) against an already running modem
ro.vendor.ril.cache_baseband_version=true
DEVICE_PROVISIONED=1

# Keep SIM state on LPM mode
persist.radio.apm_sim_not_pwdn=1

# Don't wait the card state for RADIO POWER request
persist.radio.no_wait_for_card=1

# For sys info indication
persist.radio.add_power_save=1

# Control EONS (true = EONS enabled, false = EONS disabled)
persist.eons.enabled=true

# Use CP SE13 Table
persist.radio.use_se_table_only=1

persist.data.netmgrd.qos.enable=true
persist.radio.jbims=1

# Default network: 9 (LTE / GSM / WCDMA auto)
ro.telephony.default_network=9
telephony.lteOnGsmDevice=1
ro.telephony.ril.v3=newDialCode

# Disable QMI logsmap
persist.data.qmi.adb_logmask=0

# GPS
persist.gps.qc_nlp_in_use=0
ro.gps.agps_provider=1
ro.qc.sdk.izat.premium_enabled=0
ro.qc.sdk.izat.service_mask=0x0
