new file mode 100644
index 0000000..40fb85d
--- /dev/null
+++ b/tools/acoustic-check.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""Look for the 700/silence/1100/silence/1700/silence test in PCM16 WAV.
+
+This measures a recording; it does not infer sound from ALSA stream counters.
+Exit 0 means all three tones passed, 1 means unverified, 2 means invalid input.
+"""
+
+import argparse
+import array
+import json
+import math
+import statistics
+import sys
+import wave
+
+
+TONES = (700, 1100, 1700)
+
+
+def tone_power(samples, frequency, rate):
+    coefficient = 2 * math.cos(2 * math.pi * frequency / rate)
+    previous = older = 0.0
+    for value in samples:
+        current = value + coefficient * previous - older
+        older, previous = previous, current
+    power = previous * previous + older * older - coefficient * previous * older
+    return max(0.0, 2 * power / len(samples) ** 2)
+
+
+def analyze(path):
+    with wave.open(path, "rb") as recording:
+        if recording.getsampwidth() != 2 or recording.getcomptype() != "NONE":
+            raise ValueError("requires uncompressed signed 16-bit PCM")
+        channels, rate = recording.getnchannels(), recording.getframerate()
+        # Limit memory use even if a recorder left an unfinalized WAV header.
+        values = array.array("h", recording.readframes(rate * 60))
+    if sys.byteorder != "little":
+        values.byteswap()
+    if channels < 1 or rate < 2 * max(TONES):
+        raise ValueError("invalid channel count or insufficient sample rate")
+    mono = [sum(values[i:i + channels]) / channels
+            for i in range(0, len(values) - channels + 1, channels)]
+    frames_per_bin = rate // 10
+    if len(mono) < 60 * frames_per_bin:
+        raise ValueError("requires at least six seconds of recording")
+    bins = []
+    for index in range(len(mono) // frames_per_bin):
+        samples = mono[index * frames_per_bin:(index + 1) * frames_per_bin]
+        bins.append((sum(v * v for v in samples) / len(samples),
+                     [tone_power(samples, f, rate) for f in TONES]))
+
+    best = None
+    for onset in range(len(bins) - 59):
+        measurements = []
+        for tone_index, frequency in enumerate(TONES):
+            begin = onset + tone_index * 20
+            # Omit tone edges and room decay near each transition.
+            active = bins[begin + 2:begin + 8]
+            silent = bins[begin + 12:begin + 18]
+            signal = statistics.median(b[1][tone_index] for b in active)
+            background = statistics.median(b[1][tone_index] for b in silent)
+            total = statistics.median(b[0] for b in active)
+            ratio = (signal + 1) / (background + 1)
+            fraction = signal / max(total, 1)
+            rms = math.sqrt(signal)
+            measurements.append({"hz": frequency, "tone_rms": round(rms, 2),
+                                 "active_to_silence": round(ratio, 2),
+                                 "fraction_of_power": round(fraction, 4),
+                                 "passed": rms >= 5 and ratio >= 8 and fraction >= 0.08})
+        score = min(min(m["tone_rms"] / 5, m["active_to_silence"] / 8,
+                        m["fraction_of_power"] / 0.08) for m in measurements)
+        candidate = {"detected": all(m["passed"] for m in measurements),
+                     "onset_seconds": onset / 10, "tones": measurements}
+        if best is None or score > best[0]:
+            best = score, candidate
+
+    return {"file": path, "sample_rate": rate, "channels": channels,
+            "seconds": round(len(mono) / rate, 3),
+            "peak": max(abs(v) for v in mono),
+            "rms": round(math.sqrt(sum(v * v for v in mono) / len(mono)), 2),
+            **best[1]}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("recording", help="PCM16 WAV containing the six-second test")
+    args = parser.parse_args()
+    try:
+        result = analyze(args.recording)
+    except (OSError, ValueError, wave.Error, EOFError) as error:
+        parser.exit(2, f"{error}\n")
+    print(json.dumps(result, indent=2))
+    return 0 if result["detected"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
