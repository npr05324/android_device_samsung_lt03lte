diff --git a/android/device/samsung/lt03lte/device.mk b/android/device/samsung/lt03lte/device.mk
index e72ea83..9930aae 100644
--- a/android/device/samsung/lt03lte/device.mk
+++ b/android/device/samsung/lt03lte/device.mk
@@ -128,6 +128,7 @@ PRODUCT_COPY_FILES += \
     $(DEVICE_PATH)/prebuilt/rtcoffset.sh:$(TARGET_COPY_OUT_VENDOR)/bin/rtcoffset.sh \
     $(DEVICE_PATH)/prebuilt/modem-start.sh:$(TARGET_COPY_OUT_VENDOR)/bin/modem-start.sh \
     $(DEVICE_PATH)/prebuilt/usbswitch.sh:$(TARGET_COPY_OUT_VENDOR)/bin/usbswitch.sh \
+    $(DEVICE_PATH)/prebuilt/usbwake.sh:$(TARGET_COPY_OUT_VENDOR)/bin/usbwake.sh \
     $(DEVICE_PATH)/prebuilt/usbconsole.sh:$(TARGET_COPY_OUT_VENDOR)/bin/usbconsole.sh
 
 PRODUCT_COPY_FILES += \
diff --git a/android/device/samsung/lt03lte/prebuilt/usbswitch.sh b/android/device/samsung/lt03lte/prebuilt/usbswitch.sh
index 63c1d5a..66dd67c 100755
--- a/android/device/samsung/lt03lte/prebuilt/usbswitch.sh
+++ b/android/device/samsung/lt03lte/prebuilt/usbswitch.sh
@@ -7,6 +7,17 @@
 G=/config/usb_gadget
 fails=0
 while true; do
+	# A stopped/restarting adbd has no FunctionFS descriptors. Repeatedly
+	# trying g1 in this state tears down the working serial fallback too.
+	# Leave g2 available until adbd is actually ready to own the UDC.
+	if [ "$(getprop sys.usb.config)" = adb ] && [ "$(getprop sys.usb.ffs.ready)" != 1 ]; then
+		if ! grep -q ci_hdrc $G/g2/UDC; then
+			echo '' > $G/g1/UDC
+			echo ci_hdrc.0 > $G/g2/UDC
+		fi
+		sleep 2
+		continue
+	fi
 	if [ "$(getprop sys.usb.config)" = adb ] && ! grep -q ci_hdrc $G/g1/UDC; then
 		echo "usbswitch: g1 unbound (g2='$(cat $G/g2/UDC)'), rebinding" > /dev/kmsg
 		echo '' > $G/g2/UDC
diff --git a/android/device/samsung/lt03lte/prebuilt/usbwake.sh b/android/device/samsung/lt03lte/prebuilt/usbwake.sh
new file mode 100755
index 0000000..a707d10
--- /dev/null
+++ b/android/device/samsung/lt03lte/prebuilt/usbwake.sh
@@ -0,0 +1,39 @@
+#!/system/bin/sh
+# Mainline ChipIdea disconnects an active gadget on system suspend. Match the
+# downstream active-USB suspend blocker, allowing sleep after bus suspend or
+# unplug. A bounded lock also expires if this service dies; init restarts it.
+STATE=/sys/class/udc/ci_hdrc.0/state
+LOCK=lt03lte_usb
+held=0
+trap 'if [ "$held" = 1 ]; then echo "$LOCK" > /sys/power/wake_unlock; fi' EXIT
+trap 'exit 0' HUP INT TERM
+
+while true; do
+    if [ ! -r "$STATE" ]; then
+        sleep 2
+        continue
+    fi
+    state=$(cat "$STATE") || exit 1
+    # ChipIdea can leave state="configured" after gadget unbind. Consult the
+    # bound function too so disabling USB does not retain the blocker.
+    function=$(cat /sys/class/udc/ci_hdrc.0/function) || exit 1
+    [ -n "$function" ] || state=unbound
+    case "$state" in
+        attached|powered|default|addressed|configured)
+            # Timeout is in nanoseconds. Refresh before the ten-second expiry.
+            echo "$LOCK 10000000000" > /sys/power/wake_lock || exit 1
+            if [ "$held" = 0 ]; then
+                echo "usbwake: active USB ($state), holding suspend blocker" > /dev/kmsg
+            fi
+            held=1
+            ;;
+        *)
+            if [ "$held" = 1 ]; then
+                echo "$LOCK" > /sys/power/wake_unlock || exit 1
+                held=0
+                echo "usbwake: USB $state, released suspend blocker" > /dev/kmsg
+            fi
+            ;;
+    esac
+    sleep 2
+done
diff --git a/android/device/samsung/lt03lte/rootdir/etc/init.lt03lte.rc b/android/device/samsung/lt03lte/rootdir/etc/init.lt03lte.rc
index 917091e..94c6577 100644
--- a/android/device/samsung/lt03lte/rootdir/etc/init.lt03lte.rc
+++ b/android/device/samsung/lt03lte/rootdir/etc/init.lt03lte.rc
@@ -126,6 +126,11 @@ service usbswitch /vendor/bin/usbswitch.sh
     group root
     disabled
 
+service usbwake /vendor/bin/usbwake.sh
+    class core
+    user root
+    group root
+
 service usbconsole2 /system/bin/sh -c "while [ ! -c /dev/ttyGS1 ]; do sleep 1; done; exec /system/bin/sh -i < /dev/ttyGS1 > /dev/ttyGS1 2>&1"
     class core
     user root
