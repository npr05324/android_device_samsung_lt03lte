+    /**
+     * Format a number using the subscription's country instead of the UI locale,
+     * so e.g. a Korean number is not given US (NANP) style hyphens on en-US.
+     */
+    private static String formatNumberForSubscription(String rawNumber,
+            SubscriptionInfo subscriptionInfo) {
+        final String countryIso = subscriptionInfo.getCountryIso();
+        if (!TextUtils.isEmpty(countryIso)) {
+            final String formatted = PhoneNumberUtils.formatNumber(rawNumber,
+                    countryIso.toUpperCase(Locale.ROOT));
+            if (formatted != null) {
+                return formatted;
+            }
+        }
+        return PhoneNumberUtils.formatNumber(rawNumber);
+    }
