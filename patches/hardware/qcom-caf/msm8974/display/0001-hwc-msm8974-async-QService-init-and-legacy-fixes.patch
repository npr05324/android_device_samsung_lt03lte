+static void* qservice_init_thread(void* arg) {
+    hwc_context_t* ctx = (hwc_context_t*)arg;
+    pthread_setname_np(pthread_self(), "hwc_qservice");
+    ALOGI("%s: Starting asynchronous QService initialization...", __FUNCTION__);
+    QService::init();
+    sp<IQClient> client = new QClient(ctx);
+    sp<IServiceManager> sm = defaultServiceManager();
+    if (sm != nullptr) {
+        sp<IBinder> binder = sm->getService(String16("display.qservice"));
+        if (binder != nullptr) {
+            sp<IQService> qs = interface_cast<IQService>(binder);
+            if (qs != nullptr) {
+                qs->connect(client);
+                ALOGI("%s: display.qservice client connected successfully", __FUNCTION__);
+            }
+        } else {
+            ALOGW("%s: display.qservice not available yet", __FUNCTION__);
+        }
+    } else {
+        ALOGW("%s: defaultServiceManager is null", __FUNCTION__);
+    }
+    return NULL;
+}
+
 void initContext(hwc_context_t *ctx)
 {
     openFramebufferDevice(ctx);
