-    interface_cast<IQService>(
-            defaultServiceManager()->getService(
-            String16("display.qservice")))->connect(client);
+    // Start QService in a background thread to prevent blocking HWC / SurfaceFlinger initialization
+    pthread_t qservice_thread;
+    if (pthread_create(&qservice_thread, NULL, qservice_init_thread, (void*)ctx) == 0) {
+        pthread_detach(qservice_thread);
+    } else {
+        ALOGE("%s: Failed to create qservice_init_thread", __FUNCTION__);
+    }
 
